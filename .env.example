# Application
APP_NAME=Marketplace Platform API
ENVIRONMENT=development
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL (development only; replace before any shared deployment)
POSTGRES_HOST=localhost
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_PORT=5432

# Auth (development only; generate a fresh secret per environment, never commit real secrets)
JWT_SECRET=change-me-generate-a-64-char-hex-secret-with-python-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Auth rate limiting (fixed window; login per-account counts failures only)
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_PER_IP=20
AUTH_LOGIN_RATE_LIMIT_PER_ACCOUNT=5
AUTH_REGISTER_RATE_LIMIT_PER_IP=30

# Phase 8 hardening (defaults shown; all optional)
# PAYMENTS_ALLOW_SIMULATED_OUTCOMES=true|false  (unset: dev on, prod off)
# DOCS_ENABLED=true|false                        (unset: dev on, prod off)
# ALLOWED_HOSTS=["api.example.com"]              (empty: Host check disabled)
# MAX_REQUEST_BODY_BYTES=1048576
# MAX_ACTIVE_REFRESH_TOKENS_PER_USER=10
# MAX_BIDS_PER_USER_PER_AUCTION=200
